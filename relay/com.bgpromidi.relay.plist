<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the BG-ProMIDI relay -- keeps it running in the
  background, starts it automatically when you log in, and restarts
  it if it ever crashes.

  Install (run from the `relay` folder, after `npm install`):

    mkdir -p ~/Library/LaunchAgents
    # First check where node actually lives -- Homebrew on Apple
    # Silicon installs it at /opt/homebrew/bin/node, not
    # /usr/local/bin/node:
    which node
    # Edit ProgramArguments' first string below to match that path,
    # and the /Users/felipe/... paths to match where you cloned the
    # repo if it's not in ~/Documents/GitHub/BarCounter, then:
    cp com.bgpromidi.relay.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.bgpromidi.relay.plist

  Check it's running:

    launchctl list | grep bgpromidi
    curl http://localhost:8787/health

  Logs land in relay/relay.out.log and relay/relay.err.log (paths
  below) if anything needs debugging.

  To stop/uninstall:

    launchctl unload ~/Library/LaunchAgents/com.bgpromidi.relay.plist
    rm ~/Library/LaunchAgents/com.bgpromidi.relay.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bgpromidi.relay</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/felipe/Documents/GitHub/BarCounter/relay/server.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/felipe/Documents/GitHub/BarCounter/relay</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>8787</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/felipe/Documents/GitHub/BarCounter/relay/relay.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/felipe/Documents/GitHub/BarCounter/relay/relay.err.log</string>
</dict>
</plist>
